// CampusNav — Digital Twin Schema
// Every walkable location is a Node. Edges connect Nodes.
// Rooms and Destinations resolve to Nodes. Routing consumes the graph only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth / Users ─────────────────────────────────────────────

enum RoleName {
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          RoleName  @default(ADMIN)
  image         String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  roles       UserRole[]
  sessions    Session[]
  auditLogs   AuditLog[]
  navSessions NavigationSession[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique // e.g. building.create
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@index([resource, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ── Campus Hierarchy ─────────────────────────────────────────

enum MapStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Campus {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  latitude    Float
  longitude   Float
  boundary    Json?
  status      MapStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  buildings    Building[]
  mapVersions  MapVersion[]
  nodes        Node[]
  destinations Destination[]
  obstacles    Obstacle[]
  events       Event[]
  calibrations GeoCalibration[]
  doors        Door[]
  corridors    Corridor[]
  stairGroups  StairGroup[]
  liftGroups   LiftGroup[]
  facilities   Facility[]
  mediaAssets  MediaAsset[]
}

model Building {
  id          String    @id @default(uuid())
  campusId    String
  name        String
  shortCode   String
  description String?
  color       String?
  icon        String?
  photoUrl    String?
  x           Float?
  y           Float?
  width       Float?
  height      Float?
  rotation    Float?    @default(0)
  status      MapStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campus Campus  @relation(fields: [campusId], references: [id], onDelete: Cascade)
  floors Floor[]

  @@unique([campusId, shortCode])
  @@index([campusId])
}

enum FloorType {
  BASEMENT
  GROUND
  FIRST
  SECOND
  THIRD
  ROOF
  CUSTOM
}

model Floor {
  id         String    @id @default(uuid())
  buildingId String
  name       String
  ordinal    Int
  type       FloorType @default(GROUND)
  svgUrl     String?
  isVisible  Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  building Building   @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms    Room[]
  nodes    Node[]
  doors    Door[]
  corridors Corridor[]

  @@unique([buildingId, ordinal])
  @@index([buildingId])
}

model Room {
  id                String   @id @default(uuid())
  floorId           String
  name              String
  code              String
  category          String?
  department        String?
  description       String?
  destinationNodeId String?  @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  floor           Floor @relation(fields: [floorId], references: [id], onDelete: Cascade)
  destinationNode Node? @relation("RoomDestination", fields: [destinationNodeId], references: [id])

  @@unique([floorId, code])
  @@index([floorId])
}

model Corridor {
  id        String   @id @default(uuid())
  floorId   String
  campusId  String?
  name      String?
  points    Json     // Array of {x, y} coordinates
  width     Float    @default(30.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floor  Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([floorId])
}

enum DoorType {
  ROOM_DOOR
  BUILDING_ENTRANCE
  EMERGENCY_DOOR
}

model Door {
  id              String   @id @default(uuid())
  floorId         String
  campusId        String?
  type            DoorType @default(ROOM_DOOR)
  name            String?
  x               Float
  y               Float
  connectedNodeId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  floor  Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([floorId])
}

model StairGroup {
  id              String   @id @default(uuid())
  buildingId      String
  campusId        String?
  name            String
  connectedFloors String[]
  width           Float?   @default(1.2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}

model LiftGroup {
  id              String   @id @default(uuid())
  buildingId      String
  campusId        String?
  name            String
  connectedFloors String[]
  capacity        Int?     @default(10)
  accessible      Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([buildingId])
}

model Facility {
  id          String   @id @default(uuid())
  campusId    String
  name        String
  category    String   // Parking, Restroom, ATM, Canteen, Water, Security
  description String?
  x           Float
  y           Float
  floorId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

// ── Graph ────────────────────────────────────────────────────

enum NodeType {
  ENTRANCE
  EXIT
  RECEPTION
  CORRIDOR
  JUNCTION
  ROOM
  LABORATORY
  OFFICE
  LIFT
  STAIR
  RAMP
  WASHROOM
  PARKING
  EMERGENCY_EXIT
  WATER_POINT
  BUS_STOP
  OUTDOOR
  CUSTOM
  BUILDING_ENTRANCE
}

enum EdgeType {
  WALK
  ROAD
  RAMP
  STAIRS
  LIFT
  BRIDGE
  SERVICE
  RESTRICTED
  EMERGENCY
}

model Node {
  id          String   @id @default(uuid())
  campusId    String
  floorId     String?
  type        NodeType
  name        String?
  description String?
  latitude    Float?
  longitude   Float?
  x           Float?
  y           Float?
  accessible  Boolean  @default(true)
  searchable  Boolean  @default(false)
  navigable   Boolean  @default(true)
  tags        String[] @default([])
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)
  floor  Floor? @relation(fields: [floorId], references: [id], onDelete: SetNull)

  edgesOut Edge[] @relation("EdgeFrom")
  edgesIn  Edge[] @relation("EdgeTo")

  room         Room?         @relation("RoomDestination")
  destinations Destination[]

  @@index([campusId])
  @@index([floorId])
  @@index([type])
}

model Edge {
  id              String    @id @default(uuid())
  fromNodeId      String
  toNodeId        String
  type            EdgeType  @default(WALK)
  distance        Float
  displayDistance Float?
  bidirectional   Boolean   @default(true)
  accessible      Boolean   @default(true)
  speedModifier   Float     @default(1.0)
  closed          Boolean   @default(false)
  closedReason    String?
  closedUntil     DateTime?
  status          MapStatus @default(DRAFT)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  from Node @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  to   Node @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, type])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// ── Obstacles & Events ───────────────────────────────────────

model Obstacle {
  id        String    @id @default(uuid())
  campusId  String
  floorId   String?
  x         Float
  y         Float
  radius    Float     @default(15.0)
  edgeIds   String[]  @default([])
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
  @@index([floorId])
}

model Event {
  id          String   @id @default(uuid())
  campusId    String
  title       String
  nodeId      String?
  buildingId  String?
  x           Float?
  y           Float?
  color       String?
  startsAt    DateTime
  endsAt      DateTime
  description String?
  createdAt   DateTime @default(now())

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

model GeoCalibration {
  id        String   @id @default(uuid())
  campusId  String
  floorId   String?
  canvasX   Float
  canvasY   Float
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

// ── Destinations & Search ────────────────────────────────────

model Destination {
  id          String   @id @default(uuid())
  campusId    String
  nodeId      String
  name        String
  category    String?
  roomNumber  String?
  floorId     String?
  x           Float?
  y           Float?
  width       Float?
  height      Float?
  doorId      String?
  description String?
  popularity  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campus  Campus        @relation(fields: [campusId], references: [id], onDelete: Cascade)
  node    Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  aliases SearchAlias[]

  @@index([campusId])
  @@index([nodeId])
}

model SearchAlias {
  id            String @id @default(uuid())
  destinationId String
  alias         String
  weight        Int    @default(1)

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, alias])
  @@index([alias])
}

// ── Draft vs Published Graph State ───────────────────────────

model DraftGraph {
  id        String   @id @default("active-draft")
  snapshot  Json
  updatedAt DateTime @updatedAt
}

model PublishedGraph {
  id          String   @id @default("active-published")
  version     Int      @default(1)
  snapshot    Json
  publishedAt DateTime @default(now())
  publishedBy String?
}

model MapVersion {
  id          String    @id @default(uuid())
  campusId    String?
  version     Int
  status      MapStatus @default(PUBLISHED)
  snapshot    Json
  notes       String?
  publishedAt DateTime? @default(now())
  publishedBy String?
  createdAt   DateTime  @default(now())

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([status])
}

model MediaAsset {
  id         String   @id @default(uuid())
  campusId   String?
  name       String
  url        String
  mimeType   String
  sizeBytes  Int
  entityType String   // Building, Room, Floor, Facility
  entityId   String?
  createdAt  DateTime @default(now())

  campus Campus? @relation(fields: [campusId], references: [id], onDelete: Cascade)
}

// ── Sessions / Analytics ─────────────────────────────────────

model NavigationSession {
  id            String   @id @default(uuid())
  userId        String?
  campusId      String
  startNodeId   String
  destinationId String
  distance      Float?
  durationMs    Int?
  completed     Boolean  @default(false)
  route         Json?
  createdAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([campusId])
  @@index([userId])
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  payload   Json
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

// ── Audit ────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resource, resourceId])
  @@index([userId])
}
